def mod_inverse(a, p):
    def extended_gcd(a, b):
        if b == 0:
            return a, 1, 0
        d, x1, y1 = extended_gcd(b, a % b)
        x = y1
        y = x1 - (a // b) * y1
        return d, x, y

    d, x, y = extended_gcd(a, p)
    if d != 1:
        return -1
    return x % p


def point_addition(x1, y1, x2, y2, a, p):
    if x1 is None and y1 is None:
        return x2, y2
    if x2 is None and y2 is None:
        return x1, y1

    if x1 == x2 and y1 != y2:
        return None, None

    if x1 == x2 and y1 == y2:
        if y1 == 0:
            return None, None

        inv = mod_inverse(2 * y1, p)
        if inv == -1:
            return None, None

        lam = ((3 * x1 * x1 + a) * inv) % p
    else:
        dx = (x2 - x1) % p
        dy = (y2 - y1) % p

        inv = mod_inverse(dx, p)
        if inv == -1:
            return None, None

        lam = (dy * inv) % p

    x3 = (lam * lam - x1 - x2) % p
    y3 = (lam * (x1 - x3) - y1) % p

    return x3, y3


def point_doubling(x, y, a, p):
    return point_addition(x, y, x, y, a, p)


